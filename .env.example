# ==============================================================================
# Crispyroll Environment Configuration Template
# Copy this file to .env or export these variables in your shell.
# ==============================================================================

# Display & Window Configuration
# Set to "0" to launch in windowed mode (recommended for local development)
# Set to "1" to launch in fullscreen mode (default for HTPC / Steam Deck)
FULL_SCREEN=0

# Hardware Acceleration & GPU Configuration
# Set to "1" to disable GPU acceleration (useful for VMs, headless, or broken drivers)
DISABLE_GPU=0

# Display Server & Ozone Platform
# Options: "auto" (default auto-detection), "wayland" (force native Wayland), "x11" (force X11)
# ENABLE_WAYLAND=1
OZONE_PLATFORM=auto

# Electron Logging & Debugging
# Chromium stderr verbosity (0=INFO, 1=WARNING, 2=ERROR, 3=FATAL). Default: 3
ELECTRON_ENABLE_LOGGING=0
