{
  "env": {
    "browser": true,
    "es2022": true,
    "node": true,
    "jquery": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "script"
  },
  "globals": {
    "app": "writable",
    "tvKey": "writable",
    "main": "writable",
    "service": "writable",
    "session": "writable",
    "translate": "writable",
    "languages": "writable",
    "player": "writable",
    "mapper": "writable",
    "dashjs": "readonly",
    "loading": "writable",
    "exit": "writable",
    "login": "writable",
    "mylist": "writable",
    "search": "writable",
    "historyScreen": "writable",
    "browse": "writable",
    "profilesScreen": "writable",
    "changelog": "writable",
    "home": "writable",
    "home_details": "writable",
    "home_episodes": "writable",
    "video": "writable",
    "keyboard": "writable",
    "menu": "writable",
    "settings": "writable",
    "electronUtilsRender": "readonly",
    "tizen": "readonly"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-undef": "error",
    "no-var": "error",
    "prefer-const": "warn",
    "eqeqeq": ["error", "smart"],
    "curly": ["error", "multi-line"]
  }
}
