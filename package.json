{
  "name": "crunchyroll-linux",
  "version": "1.1.6",
  "description": "Unofficial Linux HTPC Frontend for Crunchyroll",
  "homepage": "https://github.com/aarron-lee/crunchyroll-linux",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "test": "node tests/run-tests.js",
    "lint": "npx eslint .",
    "format": "npx prettier --write .",
    "build": "electron-builder",
    "build:dir": "electron-builder --linux --dir",
    "flatpak:build-unpacked": "electron-builder --linux --dir"
  },
  "build": {
    "appId": "io.github.aarron_lee.crunchyroll-linux",
    "productName": "Crunchyroll",
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/v"
    },
    "files": [
      "index.js",
      "index.html",
      "package.json",
      "src/**/*",
      "assets/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icons/crunchyroll.png",
      "artifactName": "${productName}_v${version}_linux.${ext}",
      "category": "Video"
    }
  },
  "devDependencies": {
    "electron": "github:castlabs/electron-releases#v40.7.0+wvcus",
    "electron-builder": "^26.0.12"
  },
  "keywords": [
    "crunchyroll",
    "electron",
    "linux",
    "htpc",
    "tv"
  ],
  "author": "aarron-lee",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/aarron-lee/crunchyroll-linux/issues"
  }
}
