{
  "name": "crispyroll",
  "version": "1.1.6",
  "description": "Unofficial Linux HTPC Client for Crunchyroll",
  "homepage": "https://github.com/khSafvan/crispyroll",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron --no-sandbox --no-zygote .",
    "test": "node tests/run-tests.js",
    "lint": "npx eslint .",
    "format": "npx prettier --write .",
    "build": "electron-builder",
    "build:dir": "electron-builder --linux --dir",
    "flatpak:build-unpacked": "electron-builder --linux --dir"
  },
  "build": {
    "appId": "io.github.khSafvan.crispyroll",
    "productName": "Crispyroll",
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "files": [
      "index.js",
      "index.html",
      "package.json",
      "src/**/*",
      "assets/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icons/crispyroll.png",
      "artifactName": "${productName}_v${version}_linux.${ext}",
      "category": "Video"
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "electron": "github:castlabs/electron-releases#v40.7.0+wvcus",
    "electron-builder": "^26.15.3"
  },
  "keywords": [
    "crispyroll",
    "crunchyroll",
    "electron",
    "linux",
    "htpc",
    "tv"
  ],
  "author": "khSafvan",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/khSafvan/crispyroll/issues"
  }
}
