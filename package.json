{
  "name": "crispyroll",
  "version": "0.1.0-beta.4",
  "description": "Unofficial Linux HTPC Client for Crunchyroll",
  "main": "src/main/index.js",
  "scripts": {
    "setup": "npm run bundle",
    "prestart": "npm run bundle",
    "start": "electron --no-sandbox --no-zygote .",
    "predev": "npm run bundle",
    "dev": "nodemon --watch src --watch index.html --ext js,html,css --exec \"node scripts/bundle.js && electron --no-sandbox --no-zygote .\"",
    "bundle": "node scripts/bundle.js",
    "version:update": "node scripts/version-manager.js",
    "test": "node tests/run-tests.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "verify": "python3 scripts/verify.py",
    "build": "npm run bundle && electron-builder",
    "build:dir": "npm run bundle && electron-builder --linux --dir",
    "flatpak:build-unpacked": "npm run bundle && electron-builder --linux --dir"
  },
  "build": {
    "appId": "io.crispyroll.app",
    "productName": "Crispyroll",
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "files": [
      "index.js",
      "index.html",
      "package.json",
      "src/**/*",
      "assets/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icons/crispyroll.png",
      "artifactName": "${productName}_v${version}_linux.${ext}",
      "category": "Video"
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "electron": "github:castlabs/electron-releases#v40.7.0+wvcus",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6"
  },
  "keywords": [
    "crispyroll",
    "crunchyroll",
    "electron",
    "linux",
    "htpc",
    "tv"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-store": "^8.1.0",
    "electron-unhandled": "^3.0.2",
    "qrcode": "^1.5.4"
  },
  "allowScripts": {
    "github:castlabs/electron-releases#3412c2dfbbaad4136f5b6767e902e3859222d1e8": true,
    "esbuild@0.25.12": true
  }
}
